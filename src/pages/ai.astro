---
// Landing page for Jeffery Karbowski's AI talk — standalone, no shared layout.
// Scanned via QR from the printed handout.
const title = "Jeffery Karbowski — AI Strategy & Implementation for Working Professionals";
const description = "Eighteen years of web development experience, now applied to AI. Strategy, automation, and AI-native website builds for professionals who want to stop falling behind.";
---

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..900,0..100&family=Manrope:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style is:global>
  :root {
    --paper: #F4EFE3;
    --paper-deep: #EBE3D2;
    --paper-soft: #F8F4EB;
    --ink: #1A1814;
    --ink-soft: #4A4339;
    --ink-faint: #8A8275;
    --accent: #B5471E;
    --accent-deep: #8B3414;
    --accent-soft: rgba(181, 71, 30, 0.08);
    --olive: #5C6B47;
    --rule: rgba(26, 24, 20, 0.18);
    --rule-strong: rgba(26, 24, 20, 0.4);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  body {
    font-family: 'Manrope', sans-serif;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.6;
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
    background-image:
      radial-gradient(rgba(26, 24, 20, 0.025) 1px, transparent 1px),
      radial-gradient(rgba(26, 24, 20, 0.018) 1px, transparent 1px);
    background-size: 4px 4px, 7px 7px;
    background-position: 0 0, 2px 2px;
  }

  a { color: inherit; }

  /* ── LAYOUT ─────────────────────────────────────────── */
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
  }

  section { padding: 80px 0; }

  /* ── NAV ────────────────────────────────────────────── */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(244, 239, 227, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
  }

  .nav-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 16px 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-mark {
    font-family: 'Fraunces', serif;
    font-variation-settings: "SOFT" 30, "opsz" 14;
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .nav-mark .amp {
    font-style: italic;
    font-variation-settings: "SOFT" 100;
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    gap: 28px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .nav-links a {
    text-decoration: none;
    color: var(--ink-soft);
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--accent); }

  .nav-cta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
    padding: 8px 16px;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.2s;
  }
  .nav-cta:hover { background: var(--accent); }

  /* ── HERO ───────────────────────────────────────────── */
  .hero {
    padding: 100px 0 80px;
    position: relative;
    overflow: hidden;
  }

  .hero-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .hero-eyebrow::before {
    content: '';
    width: 40px;
    height: 1px;
    background: var(--accent);
  }

  .hero h1 {
    font-family: 'Fraunces', serif;
    font-variation-settings: "SOFT" 30, "opsz" 144;
    font-weight: 500;
    font-size: clamp(48px, 7vw, 92px);
    line-height: 0.96;
    letter-spacing: -0.035em;
    max-width: 14ch;
    margin-bottom: 32px;
  }
  .hero h1 em {
    font-style: italic;
    font-variation-settings: "SOFT" 100, "opsz" 144;
    color: var(--accent);
    font-weight: 400;
  }

  .hero-lede {
    font-size: 19px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 52ch;
    margin-bottom: 40px;
  }

  .hero-ctas {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
  }

  .btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 16px 28px;
    border-radius: 2px;
    transition: all 0.25s;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
  }
  .btn-primary {
    background: var(--ink);
    color: var(--paper);
  }
  .btn-primary:hover {
    background: var(--accent);
    transform: translateY(-1px);
  }
  .btn-ghost {
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--rule-strong);
  }
  .btn-ghost:hover {
    border-color: var(--ink);
    background: var(--paper-deep);
  }
  .btn .arrow { font-size: 14px; transition: transform 0.25s; }
  .btn:hover .arrow { transform: translateX(4px); }

  /* ── STATS STRIP ────────────────────────────────────── */
  .stats {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 40px 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .stat {
    border-left: 2px solid var(--accent);
    padding-left: 18px;
  }
  .stat:first-child { border-left: none; padding-left: 0; }

  .stat-num {
    font-family: 'Fraunces', serif;
    font-variation-settings: "SOFT" 40, "opsz" 144;
    font-weight: 600;
    font-size: 44px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .stat-num em {
    font-style: italic;
    font-variation-settings: "SOFT" 100;
    color: var(--accent);
  }
  .stat-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    line-height: 1.4;
  }

  /* ── SECTION HEAD ───────────────────────────────────── */
  .section-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .section-eyebrow .num {
    background: var(--accent-soft);
    color: var(--accent);
    padding: 4px 8px;
    border-radius: 2px;
    font-weight: 500;
  }

  .section-title {
    font-family: 'Fraunces', serif;
    font-variation-settings: "SOFT" 40, "opsz" 144;
    font-weight: 500;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin-bottom: 24px;
    max-width: 18ch;
  }
  .section-title em {
    font-style: italic;
    font-variation-settings: "SOFT" 100;
    color: var(--accent);
    font-weight: 400;
  }

  .section-lede {
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 56ch;
    margin-bottom: 56px;
  }

  /* ── ABOUT ──────────────────────────────────────────── */
  .about {
    background: var(--paper-soft);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 64px;
    align-items: start;
  }

  .about-headline {
    font-family: 'Fraunces', serif;
    font-variation-settings: "SOFT" 40, "opsz" 144;
    font-weight: 500;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .about-headline em {
    font-style: italic;
    font-variation-settings: "SOFT" 100;
    color: var(--accent);
  }

  .about-body {
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink);
  }
  .about-body p { margin-bottom: 18px; }
  .about-body p:last-child { margin-bottom: 0; }
  .about-body strong { color: var(--accent-deep); font-weight: 600; }

  /* ── SERVICES ───────────────────────────────────────── */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .service-card {
    background: var(--paper);
    padding: 36px 32px;
    transition: background 0.2s;
  }
  .service-card:hover { background: var(--paper-soft); }

  .service-num {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: var(--accent);
    letter-spacing: 0.2em;
    margin-bottom: 20px;
    font-weight: 500;
  }

  .service-name {
    font-family: 'Fraunces', serif;
    font-variation-settings: "opsz" 144;
    font-weight: 600;
    font-size: 22px;
    line-height: 1.1;
    margin-bottom: 12px;
    letter-spacing: -0.015em;
  }

  .service-body {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  /* ── PRICING ────────────────────────────────────────── */
  .pricing {
    background: var(--ink);
    color: var(--paper);
    background-image:
      radial-gradient(rgba(244, 239, 227, 0.03) 1px, transparent 1px),
      radial-gradient(rgba(244, 239, 227, 0.02) 1px, transparent 1px);
    background-size: 4px 4px, 7px 7px;
  }

  .pricing .section-eyebrow { color: var(--accent); }
  .pricing .section-eyebrow .num { background: rgba(181, 71, 30, 0.18); }
  .pricing .section-title { color: var(--paper); }
  .pricing .section-lede { color: var(--paper-deep); }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 56px;
  }

  .price-card {
    background: rgba(244, 239, 227, 0.04);
    border: 1px solid rgba(244, 239, 227, 0.12);
    padding: 36px 32px;
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all 0.3s;
  }
  .price-card:hover {
    background: rgba(244, 239, 227, 0.06);
    border-color: rgba(244, 239, 227, 0.22);
    transform: translateY(-4px);
  }

  .price-card.featured {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--accent);
  }
  .price-card.featured:hover {
    background: var(--paper-soft);
  }

  .price-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: var(--paper);
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 2px;
    font-weight: 500;
  }

  .price-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
    font-weight: 500;
  }

  .price-amount {
    font-family: 'Fraunces', serif;
    font-variation-settings: "SOFT" 30, "opsz" 144;
    font-weight: 500;
    font-size: 52px;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 4px;
  }
  .price-amount .currency {
    font-size: 28px;
    vertical-align: super;
    line-height: 1;
    margin-right: 2px;
    color: var(--ink-faint);
  }
  .price-card.featured .price-amount .currency { color: var(--ink-faint); }
  .price-card:not(.featured) .price-amount .currency { color: var(--ink-faint); }

  .price-period {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
    margin-bottom: 8px;
  }
  .price-card.featured .price-period { color: var(--ink-faint); }

  .price-tag {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 14px;
    color: var(--paper-deep);
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(244, 239, 227, 0.12);
  }
  .price-card.featured .price-tag {
    color: var(--ink-soft);
    border-bottom-color: var(--rule);
  }

  .price-features {
    list-style: none;
    margin-bottom: 32px;
    flex: 1;
  }

  .price-features li {
    font-size: 14px;
    line-height: 1.5;
    padding: 8px 0 8px 22px;
    position: relative;
    color: var(--paper);
  }
  .price-card.featured .price-features li { color: var(--ink); }

  .price-features li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 600;
  }

  .price-cta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 14px 20px;
    border-radius: 2px;
    text-align: center;
    transition: all 0.2s;
    font-weight: 500;
    border: 1px solid rgba(244, 239, 227, 0.3);
    color: var(--paper);
  }
  .price-cta:hover {
    background: var(--accent);
    border-color: var(--accent);
  }
  .price-card.featured .price-cta {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .price-card.featured .price-cta:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  .pricing-note {
    margin-top: 40px;
    text-align: center;
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 16px;
    color: var(--paper-deep);
    max-width: 60ch;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.5;
  }
  .pricing-note em {
    font-style: normal;
    color: var(--accent);
  }

  /* ── PROCESS ────────────────────────────────────────── */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin-top: 16px;
    counter-reset: step;
  }

  .process-step {
    position: relative;
    counter-increment: step;
  }

  .process-step::before {
    content: '0' counter(step);
    font-family: 'Fraunces', serif;
    font-variation-settings: "opsz" 144;
    font-weight: 400;
    font-style: italic;
    font-size: 56px;
    line-height: 0.9;
    color: var(--accent);
    display: block;
    margin-bottom: 18px;
    letter-spacing: -0.04em;
  }

  .process-step h4 {
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 18px;
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .process-step p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  /* ── FAQ ────────────────────────────────────────────── */
  .faq-list {
    max-width: 760px;
    border-top: 1px solid var(--rule);
  }

  details {
    border-bottom: 1px solid var(--rule);
  }

  summary {
    list-style: none;
    cursor: pointer;
    padding: 22px 0;
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.01em;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    transition: color 0.2s;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--accent); }

  summary::after {
    content: '+';
    font-family: 'JetBrains Mono', monospace;
    font-size: 24px;
    color: var(--accent);
    font-weight: 300;
    transition: transform 0.3s;
    flex-shrink: 0;
  }
  details[open] summary::after { transform: rotate(45deg); }

  details > p {
    padding: 0 0 24px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 65ch;
  }

  /* ── FINAL CTA ──────────────────────────────────────── */
  .final-cta {
    background: var(--accent);
    color: var(--paper);
    text-align: center;
    padding: 100px 0;
    position: relative;
    overflow: hidden;
  }
  .final-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(rgba(244, 239, 227, 0.06) 1px, transparent 1px);
    background-size: 6px 6px;
    pointer-events: none;
  }

  .final-cta-inner { position: relative; }

  .final-cta-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(244, 239, 227, 0.7);
    margin-bottom: 28px;
  }

  .final-cta h2 {
    font-family: 'Fraunces', serif;
    font-variation-settings: "SOFT" 50, "opsz" 144;
    font-weight: 500;
    font-size: clamp(40px, 5.5vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
    max-width: 18ch;
    margin-left: auto;
    margin-right: auto;
  }
  .final-cta h2 em {
    font-style: italic;
    font-variation-settings: "SOFT" 100;
    color: var(--ink);
  }

  .final-cta-lede {
    font-size: 19px;
    line-height: 1.5;
    color: rgba(244, 239, 227, 0.92);
    max-width: 48ch;
    margin: 0 auto 40px;
  }

  .final-cta .btn-primary {
    background: var(--ink);
    font-size: 13px;
    padding: 18px 36px;
  }
  .final-cta .btn-primary:hover { background: var(--paper); color: var(--ink); }

  /* ── FOOTER ─────────────────────────────────────────── */
  footer {
    background: var(--ink);
    color: var(--paper-deep);
    padding: 56px 0 32px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(244, 239, 227, 0.12);
  }

  .footer-brand {
    font-family: 'Fraunces', serif;
    font-variation-settings: "SOFT" 30;
    font-weight: 600;
    font-size: 28px;
    color: var(--paper);
    margin-bottom: 12px;
    letter-spacing: -0.015em;
  }
  .footer-brand .amp {
    font-style: italic;
    font-variation-settings: "SOFT" 100;
    color: var(--accent);
  }
  .footer-tag {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 16px;
    color: var(--paper-deep);
    max-width: 36ch;
    line-height: 1.4;
  }

  .footer-col h5 {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
    font-weight: 500;
  }
  .footer-col a, .footer-col span {
    display: block;
    font-size: 14px;
    color: var(--paper);
    text-decoration: none;
    margin-bottom: 8px;
    transition: color 0.2s;
  }
  .footer-col a:hover { color: var(--accent); }

  .footer-base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    text-transform: uppercase;
  }

  /* ── RESPONSIVE ─────────────────────────────────────── */
  @media (max-width: 880px) {
    section { padding: 60px 0; }
    .nav-links { display: none; }
    .nav-inner { padding: 14px 24px; }
    .container { padding: 0 24px; }
    .stats { grid-template-columns: 1fr 1fr; gap: 24px; }
    .stat { border-left: none; padding-left: 0; }
    .about-grid { grid-template-columns: 1fr; gap: 32px; }
    .services-grid { grid-template-columns: 1fr; }
    .pricing-grid { grid-template-columns: 1fr; gap: 16px; }
    .price-card.featured { transform: none; order: -1; }
    .process-grid { grid-template-columns: 1fr 1fr; gap: 32px 24px; }
    .footer-grid { grid-template-columns: 1fr; gap: 32px; }
    .footer-base { flex-direction: column; gap: 12px; }
    .hero { padding: 60px 0 40px; }
  }

  @media (max-width: 540px) {
    .process-grid { grid-template-columns: 1fr; }
    .hero-ctas { flex-direction: column; align-items: stretch; }
    .btn { justify-content: center; }
  }

  /* ── REVEAL ANIMATION ───────────────────────────────── */
  @keyframes rise {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
